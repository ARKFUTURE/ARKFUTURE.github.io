## Kamailio 控制工具(kamctl 和 kamdbctl)的配置文件.
##
## 您可以在此处设置 kamctl 和 kamdbctl 设置脚本中使用的变量.
## 默认情况下，此处所有变量均被注释掉，控制工具将使用其内部默认值.

## SIP 域名
SIP_DOMAIN=IP/Doman

## chroot 目录
# CHROOT_DIR="/path/to/chrooted/directory"

## 数据库类型:MYSQL, PGSQL, ORACLE, DB_BERKELEY, DBTEXT, 或 SQLITE
## 默认不加载任何类型
##
## 如果您想使用 kamdbctl 设置数据库，则必须至少指定此参数.
DBENGINE=MYSQL

## 数据库主机
DBHOST=localhost

## 数据库端口
DBPORT=3306

## 数据库名称
DBNAME=kamailio

## dbtext、db_berkeley 或 sqlite 使用的数据库路径
# DB_PATH="/usr/local/etc/kamailio/dbtext"

## 数据库读/写用户
DBRWUSER="kamailio"

## 数据库读/写用户的密码
DBRWPW="QskAYU@8DdaYbGAZptAZ"

## 数据库只读用户
DBROUSER="kamailioro"

## 数据库只读用户的密码
DBROPW="vjYN7mbwPpdfa4Jutasp"

## 数据库访问主机(从何处使用 kamctl)
# DBACCESSHOST=192.168.0.1

## 超级用户的数据库主机(用于指定本地套接字或虚拟主机名)
## 如果未设置，则默认使用 DBHOST 的值
# DBROOTHOST="localhost"

## 超级用户的数据库端口(在某些数据库上，指定端口将强制使用 TCP 连接)
## 默认值取决于客户端数据库工具
# DBROOTPORT=""

## 数据库超级用户
DBROOTUSER="root"

## 数据库超级用户的密码
## - 重要提示:此方式不安全，仅用于自动化测试场景
## - 已知适用于:mysql
DBROOTPW="wbCXfATYXVeMpMXJWkG5"

## 询问确认所有数据库创建步骤的选项
# DBINITASK=yes

## 数据库字符集(MySQL 创建数据库时使用)
CHARSET="utf8mb4"

## 用户名列名
# USERCOL="username"


## SQL 定义
## 如果您在此处更改这些定义，则必须在 db/schema/entities.xml 中也进行相应更改.
##
## 需修改
# FOREVER="2030-05-28 21:32:15"
# DEFAULT_Q="1.0"


## 用于计算消息摘要指纹的程序
# MD5="md5sum"

## awk 工具
# AWK="awk"

## gdb 工具
# GDB="gdb"

## 如果您使用的系统(例如 Solaris)中的 grep 和 egrep 并非 100% 兼容 GNU grep，
## 请安装 GNU grep (ggrep) 并在下方指定.
##
## grep 工具
# GREP="grep"

## egrep 工具
# EGREP="egrep"

## sed 工具
# SED="sed"

## tail 工具
# LAST_LINE="tail -n 1"

## expr 工具
# EXPR="expr"


## 描述要安装哪些额外的表.以下变量的有效值为 yes/no/ask.
## 使用 ask(默认值)时会交互式询问用户答案，而使用 yes/no 则允许自动化、无人值守的安装.

## 是否安装 EXTRA_MODULES 变量中模块的表.
INSTALL_EXTRA_TABLES=yes

## 是否安装 Presence 相关表.
INSTALL_PRESENCE_TABLES=yes

## 是否安装 uid 模块相关表.
INSTALL_DBUID_TABLES=yes

## 定义应安装哪些模块表.
## 如果您使用 PostgreSQL 数据库并希望更改已安装的表，则还必须相应地调整
## kamdbctl.base 脚本中的 STANDARD_TABLES 或 EXTRA_TABLES 变量.

## Kamailio 标准模块
STANDARD_MODULES="standard acc lcr domain group permissions registrar usrloc msilo
                  alias_db uri_db speeddial avpops auth_db pdt dialog dispatcher
                  dialplan"

## Kamailio 额外模块
EXTRA_MODULES="imc cpl siptrace carrierroute userblocklist htable sca"


## 别名类型:DB - 数据库别名; UL - 用户定位(usrloc)别名
## - 默认值:无
# ALIASES_TYPE="DB"

## 控制引擎:RPCFIFO
## - 默认值为 RPCFIFO
# CTLENGINE="RPCFIFO"

## 引擎 RPCFIFO 的 FIFO 文件路径
# RPCFIFOPATH="/run/kamailio/kamailio_rpc.fifo"

## 检查 ACL 名称;默认开启 (1);关闭 (0)
# VERIFY_ACL=1

## ACL 名称 - 如果设置了 VERIFY_ACL，则只接受以下列表中的 ACL 名称
# ACL_GROUPS="local ld int voicemail free-pstn"

## 检查用户是否存在(被某些命令使用，例如 acl);
## - 默认开启 (1);关闭 (0)
# VERIFY_USER=1

## 详细输出 - 调试目的 - 默认值为 '0'
# VERBOSE=1

## 是否在 subscriber 表中存储明文密码
## 1 为存储，0 为不存储 - 默认值为 '1'
STORE_PLAINTEXT_PW=1

## Kamailio 启动选项
## PID 文件路径 - 默认路径为:/run/kamailio/kamailio.pid
# PID_FILE=/run/kamailio/kamailio.pid

## Kamailio 启动配置文件
## 默认文件为:kamailio.cfg
# STARTUP_CONFIG_FILE=kamailio.cfg

## 额外的启动选项 - 默认不设置
## 示例:使用 64MB 共享内存启动 Kamailio:STARTOPTIONS="-m 64"
# STARTOPTIONS=